{% extends 'pages/_base.jinja' %}

{% block content %}

    <h2>New project</h2>

    <form method="post" action="/project/new">
        <label>

            Name
            <input type="text" name="name" required>

        </label>

        <label>
        
            Deadline
            <input type="text" name="deadline" required>

        </label>


        <button>Add project</button>
    
    </form>

{% endblock %}

