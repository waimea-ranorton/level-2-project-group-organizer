{% extends 'pages/_base.jinja' %}


{% block content %}

    <nav id="Cal">
        <div class="Upcoming"> <a href="/calendar">Upcoming</a> </div>
        <div class="Finished"> <a href="/calendar/finished">Finished</a> </div>
        <div class="Past_due"> <a href="/calendar/past_due">Past due</a> </div>
    </nav> 

    <h2>Finished Projects</h2> 
     <section id="projects">
        {% for project in projects %}

             <div class="project">
                <h2>Project: </h2> <h3>{{ project.name }} </h3>
                <div class="Deadline">
                    <h3>Deadline: </h3><h4>{{ project.deadline }}</h4>
                </div>    
                
                <div class="Buttons">
                    {% if project %} 
                    <p><a href="/project/{{ project.id }}/delete">delete</a></p>
                    {% endif %}

                    {% if project %} 
                    <p><a href="/project/{{ project.id }}/finished">finished</a></p>
                    {% endif %}

                </div>    
                  
            </div>
        {% else %}

            <p>No projects!</p>

        {% endfor %}     

    </section>

{% endblock %}


